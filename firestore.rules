rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tausifsayyed85@gmail.com' ||
        request.auth.token.email.matches('.*@hotelradhakrishna\\.com')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Guest inquiries for rooms, dining, banquets
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.mobileNumber is string
                    && request.resource.data.type is string;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Restaurant menu items
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
